# TEMPLATE ONLY: this file is committed to git, so it must never hold real
# values. Copy it to .env.local (never committed) and put the real ones there.

# ---------------------------------------------------------------------------
# Blog admin (/admin/)
# ---------------------------------------------------------------------------

# Neon Postgres: console.neon.tech -> your project -> Connect -> copy the
# connection string. Then run `npm run blog:setup` once (creates the table and
# loads the nine built-in articles).
# Leave it empty and the public blog shows those nine articles from
# src/data/guide/seed-posts.json; the admin then only shows a setup notice.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2, for images uploaded in the editor (covers, article photos).
#   Account id: dash.cloudflare.com -> R2 -> Overview (right-hand side).
#   Keys:       R2 -> Manage API tokens -> Create API token, permission
#               "Object Read & Write", limited to this bucket. Use the
#               Access Key ID and Secret Access Key (not the token value).
#   Public URL: the bucket -> Settings -> Custom Domains (or its r2.dev address)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spabalimoon-blog
R2_PUBLIC_URL=https://images.spabalimoon.com
# Only for EU / FedRAMP buckets, whose API address is different:
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com

# The admin login password, and the key that seals the login cookie
# (a random string of at least 32 characters, e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=random-string-at-least-32-characters-long

# Cloudflare cache purging after an article is saved (optional; leave blank
# and every purge is skipped). Token permission: Zone -> Cache Purge -> Purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Newsletter sign-up (footer form, /api/subscribe/) — the same settings as the
# old site's project (D:\Next.js Data\spabalimoon\.env.local)
# ---------------------------------------------------------------------------

# Google Apps Script web app that appends the address to the owner's sheet.
# Leave it empty and nothing is stored (the welcome email is still sent).
GOOGLE_SHEET_WEBAPP_URL=

# SendGrid: app.sendgrid.com -> Settings -> API Keys (permission "Mail Send").
# The sender address must be a verified sender or on a verified domain.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Name shown as the sender and in the email (optional).
BUSINESS_NAME=Spa Bali Moon
